{
  "name": "shim-reachability",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "光学平台 A/B 两级垫片补偿目标可达性精确判定（React + TypeScript + Vite）",
  "scripts": {
    "dev": "vite",
